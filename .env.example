# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_NOTIFICATION=your_notification_template_id_here
VITE_EMAILJS_TEMPLATE_CONFIRMATION=your_confirmation_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Sheets Configuration
# Option A: Apps Script Web app URL (recommended for production – no CORS issues)
# Deploy your sheet as Web app in Extensions → Apps Script, then paste the exec URL here.
VITE_GOOGLE_SHEETS_SCRIPT_URL=

# Option B: Sheet sharing URL (used when script URL is not set; uses CORS proxy in production)
VITE_GOOGLE_SHEETS_URL=your_google_sheet_url_here
